# BGCK QUANT FINTECH - API CLUSTER CONFIGURATION
# Copy this file to .env and fill in your Gemini Flash API keys.
# The system will automatically rotate keys to handle rate limits and 429 errors.

GEMINI_API_KEY_1="paste_your_key_here"
GEMINI_API_KEY_2="paste_your_key_here"
GEMINI_API_KEY_3="paste_your_key_here"
GEMINI_API_KEY_4="paste_your_key_here"
GEMINI_API_KEY_5="paste_your_key_here"

# OPTIONAL: Backend Port (Default: 8000)
PORT=8000
